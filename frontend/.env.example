# Copy this file to ".env" to override the defaults. ".env" is git-ignored.

# Where the Spring Boot backend runs (Vite proxies /api/* here)
BACKEND_URL=http://localhost:8080

# Login the Vite proxy sends to the backend. Must match
# spring.security.user.* in backend/src/main/resources/application-dev.properties
BACKEND_USERNAME=demo
BACKEND_PASSWORD=demo123
